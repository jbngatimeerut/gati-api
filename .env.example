# --- database (Neon free Postgres) ---
DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# --- auth ---
JWT_SECRET="replace-with-a-long-random-string"
NODE_ENV="production"          # in dev, OTP code is also returned in the API response

# --- where the web app lives (set to the cloud URL now, your domain later) ---
WEB_ORIGIN="https://gati-web-dev.vercel.app"
PORT=4000

# --- free email (Brevo: 300/day free). Leave blank in dev to log codes to console ---
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-login"
SMTP_PASS="your-brevo-smtp-key"
MAIL_FROM="JITO GATI <no-reply@yourdomain.in>"

# --- AI-powered directory search ---
# All optional. Whichever of these keys is set determines which embedding provider is used, in
# this quality-ranked priority order: Voyage > OpenAI > Gemini > local (no key at all). Only the
# highest-priority key present is used; the rest sit unused as an upgrade path. Leave all blank
# and semantic search still works out of the box via a free, fully local/offline model
# (@xenova/transformers) — no key, no cost, no data leaving your server.
VOYAGE_API_KEY=          # https://dashboard.voyageai.com — best retrieval quality, small free trial credit
OPENAI_API_KEY=          # https://platform.openai.com/api-keys — text-embedding-3-large, no free tier
GEMINI_API_KEY=          # https://aistudio.google.com/app/apikey — free ongoing quota, mid-tier quality

# --- APNs: push notifications when the iOS app is fully closed ---
# Optional — everything else in the notifications system (live updates while the app is open or
# briefly backgrounded, the persistent /notifications history) already works with zero setup.
# This only gates the killed-app push. Requires your own Apple Developer Program account:
#   1. developer.apple.com -> Certificates, Identifiers & Profiles -> Keys -> "+" -> enable
#      "Apple Push Notifications service (APNs)" -> Continue -> Register -> download the .p8 file
#      (you only get one download — keep it safe). Note the Key ID shown on that page.
#   2. Team ID is on the membership page (developer.apple.com/account -> Membership details).
#   3. Bundle ID is the app's identifier in Xcode (Signing & Capabilities) — in.jito.gati today.
# Paste the entire .p8 file contents (including the BEGIN/END lines) as APNS_PRIVATE_KEY, escaping
# newlines as \n if your env-loading tool needs it on one line.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID="in.jito.gati"
APNS_PRIVATE_KEY=
APNS_PRODUCTION=false    # true once submitting to TestFlight/App Store
